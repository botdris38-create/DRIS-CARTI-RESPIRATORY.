
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>COSZI BATANG HENERAL V1.0</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #160b2e;
      color: white;
      min-height: 100vh;
      padding: 25px;
    }

    header {
      background: #32145c;
      padding: 25px;
      border-radius: 16px;
      margin-bottom: 25px;
      border: 1px solid #7041a5;
    }

    h1 {
      color: #d8b4fe;
      font-size: 25px;
    }

    .subtitle {
      color: #c4b5fd;
      margin-top: 8px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
    }

    .panel {
      background: #281344;
      border: 1px solid #59318a;
      padding: 22px;
      border-radius: 14px;
    }

    .panel h2 {
      color: #d8b4fe;
      margin-bottom: 12px;
      font-size: 18px;
    }

    .status {
      color: #86efac;
      font-weight: bold;
    }

    footer {
      text-align: center;
      margin-top: 35px;
      color: #a78bca;
      font-size: 13px;
    }
  </style>
</head>
<body>
  <header>
    <h1>COSZI BATANG HENERAL</h1>
    <p class="subtitle">RESPIRATORY PROJECT • VERSION 1.0</p>
  </header>

  <main class="grid">
    <section class="panel">
      <h2>System Status</h2>
      <p class="status">● Dashboard Ready</p>
    </section>

    <section class="panel">
      <h2>Bot Status</h2>
      <p id="botStatus">Checking...</p>
    </section>

    <section class="panel">
      <h2>Project</h2>
      <p>DRIS CARTI RESPIRATORY</p>
    </section>

    <section class="panel">
      <h2>Version</h2>
      <p>V1.0.0</p>
    </section>
  </main>

  <footer>
    COSZI BATANG HENERAL © 2026
  </footer>

  <script>
    fetch("/health")
      .then(response => response.json())
      .then(data => {
        document.getElementById("botStatus").textContent =
          data.status === "online" ? "Server Online" : "Offline";
      })
      .catch(() => {
        document.getElementById("botStatus").textContent =
          "Server Unavailable";
      });
  </script>
</body>
</html>
